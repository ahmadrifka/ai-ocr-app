# Set to google_genai to temporarily use Google's Gen AI SDK; default is openai.
LLM_PROVIDER=google_genai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gemini-3.5-flash-lite
FILESTORE_PATH=./filestore
DATABASE_URL=postgresql://postgres:***@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
OCR_API_BASE_URL=http://127.0.0.1:8000
BOT_POLL_INTERVAL_SECONDS=1.5
BOT_POLL_TIMEOUT_SECONDS=60.0
ALLOWED_TELEGRAM_USER_IDS=291476947

# Langfuse LLM tracing (optional; tracing is off when keys are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Deployment (see "Deploy to Render" in README.md)
# production refuses to start without DASHBOARD_PASSWORD or API_KEY.
APP_ENV=development
# Dashboard sign-in password; SESSION_SECRET signs the session cookie.
DASHBOARD_PASSWORD=
SESSION_SECRET=
# Machine clients (the Telegram bot) send this as the X-API-Key header.
API_KEY=
# Run the OCR worker inside the API process (single-instance hosting).
RUN_WORKER_IN_API=false

# Image storage: local (FILESTORE_PATH) or supabase (private Storage bucket).
STORAGE_BACKEND=local
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# Telegram webhook mode (instead of `python -m bot.main` polling).
TELEGRAM_WEBHOOK_ENABLED=false
# Public HTTPS URL of the API; Render provides RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=