# Set to google_genai to temporarily use Google's Gen AI SDK; default is openai.
LLM_PROVIDER=google_genai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gemini-3.5-flash-lite
FILESTORE_PATH=./filestore
DATABASE_URL=postgresql://postgres:***@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
OCR_API_BASE_URL=http://127.0.0.1:8000
BOT_POLL_INTERVAL_SECONDS=1.5
BOT_POLL_TIMEOUT_SECONDS=60.0
ALLOWED_TELEGRAM_USER_IDS=291476947

# Langfuse LLM tracing (optional; tracing is off when keys are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
